# Copy to .env for local development:  cp .env.example .env
# These are local-only dev values. Generate real secrets for anything deployed.
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgres://finsight:finsight@db:5432/finsight
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
