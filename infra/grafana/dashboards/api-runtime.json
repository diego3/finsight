{
  "uid": "finsight-api-runtime",
  "title": "FinSight — API Runtime (Python)",
  "tags": ["finsight", "python"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workers",
      "description": "Live Python processes exposing metrics. 1 under runserver; GUNICORN_WORKERS under gunicorn (each series carries a pid label).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "count(process_resident_memory_bytes{job=\"django\"})" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total RSS",
      "description": "Sum of resident memory across all workers. CPython has no fixed heap/stack to report — RSS is the real footprint.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(process_resident_memory_bytes{job=\"django\"})" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GC-tracked objects (all workers)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(python_gc_tracked_objects{job=\"django\"})" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Allocator blocks (all workers)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(python_allocated_blocks{job=\"django\"})" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Resident memory per worker",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"django\"}", "legendFormat": "pid {{pid}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU per worker (cores)",
      "description": "Rate of process_cpu_seconds_total per worker. Complements the cgroup CPU on the Containers dashboard.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"django\"}[1m])", "legendFormat": "pid {{pid}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC collections/s by generation",
      "description": "Summed across workers. Gen 0 runs most; frequent gen 2 runs mean lots of long-lived objects churning.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (generation) (rate(python_gc_collections_total{job=\"django\"}[1m]))", "legendFormat": "gen {{generation}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC objects reclaimed/s by generation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (generation) (rate(python_gc_objects_collected_total{job=\"django\"}[1m]))", "legendFormat": "gen {{generation}}" },
        { "refId": "B", "expr": "sum by (generation) (rate(python_gc_objects_uncollectable_total{job=\"django\"}[5m]))", "legendFormat": "uncollectable gen {{generation}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC pending allocations by generation (avg worker)",
      "description": "gc.get_count(): allocations minus deallocations since each generation was last collected. Gen 0 sawtooths up to its threshold (~700) then resets.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "avg by (generation) (python_gc_pending_objects{job=\"django\"})", "legendFormat": "gen {{generation}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Open file descriptors & tracemalloc",
      "description": "FDs per worker (summed). tracemalloc series only appear when PYTHONTRACEMALLOC is set on the api service (it roughly doubles memory use).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [
        { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
      ] },
      "targets": [
        { "refId": "A", "expr": "sum(process_open_fds{job=\"django\"})", "legendFormat": "open fds (total)" },
        { "refId": "B", "expr": "sum by (kind) (python_tracemalloc_bytes{job=\"django\"})", "legendFormat": "tracemalloc {{kind}}" }
      ]
    }
  ]
}
