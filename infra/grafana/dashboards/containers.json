{
  "uid": "finsight-containers",
  "title": "FinSight — Containers & App",
  "tags": ["finsight"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{cname=~\"finsight-api|finsight-web|postgres\"}[1m])",
          "legendFormat": "{{cname}}"
        },
        {
          "refId": "B",
          "expr": "container_spec_cpu_quota{cname=~\"finsight-api|finsight-web|postgres\"} / container_spec_cpu_period{cname=~\"finsight-api|finsight-web|postgres\"}",
          "legendFormat": "{{cname}} (limit)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory: working set vs limit",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{cname=~\"finsight-api|finsight-web|postgres\"}",
          "legendFormat": "{{cname}}"
        },
        {
          "refId": "B",
          "expr": "container_spec_memory_limit_bytes{cname=~\"finsight-api|finsight-web|postgres\"} > 0",
          "legendFormat": "{{cname}} (limit)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Django responses/s by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API latency p95 by endpoint",
      "description": "95th percentile request latency per DRF view + HTTP method, from django_http_requests_latency_seconds_by_view_method.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, view, method) (rate(django_http_requests_latency_seconds_by_view_method_bucket{view!=\"prometheus-django-metrics\"}[5m])))",
          "legendFormat": "{{method}} {{view}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API latency p50 by endpoint",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, view, method) (rate(django_http_requests_latency_seconds_by_view_method_bucket{view!=\"prometheus-django-metrics\"}[5m])))",
          "legendFormat": "{{method}} {{view}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API request rate by endpoint",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (view, method) (rate(django_http_requests_total_by_view_transport_method_total{view!=\"prometheus-django-metrics\"}[1m]))",
          "legendFormat": "{{method}} {{view}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU throttling (fraction of periods throttled)",
      "description": "Share of CFS scheduler periods in which the container was throttled because it hit its cpu limit. Anything above 0 means the limit is being enforced against real demand.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_cfs_throttled_periods_total{cname=~\"finsight-api|finsight-web|postgres\"}[1m]) / clamp_min(rate(container_cpu_cfs_periods_total{cname=~\"finsight-api|finsight-web|postgres\"}[1m]), 1)",
          "legendFormat": "{{cname}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU throttled time",
      "description": "Seconds of run time the container was denied per second, summed across its tasks.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_cfs_throttled_seconds_total{cname=~\"finsight-api|finsight-web|postgres\"}[1m])",
          "legendFormat": "{{cname}}"
        }
      ]
    }
  ]
}
